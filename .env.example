# =============================================================================
# LOCAL / EXAMPLES ONLY — never commit real secrets.
# Production: put provider keys + DATABASE_URL on Railway (API Variables).
# Desktop may only know the public API URL.
# =============================================================================

# --- Local API (optional: only if you run `pnpm dev:api` on your machine) ---
ARRAB_API_HOST=127.0.0.1
ARRAB_API_PORT=8787
ARRAB_API_LOG_LEVEL=info
ARRAB_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# PostgreSQL — optional for local API. Leave unset for in-memory.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/arrab

# --- Amazon Bedrock (Railway Variables) ---
# Long-term API key from AWS Bedrock → API keys → Generate long-term API key
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-north-1
# Comma-separated Bedrock model IDs (exactly 3 recommended)
BEDROCK_MODELS=google.gemma-3-12b-it,amazon.nova-lite-v1:0,amazon.nova-pro-v1:0,openai.gpt-oss-120b
ARRAB_DEFAULT_MODEL=google.gemma-3-12b-it

# Optional other providers (leave empty when using Bedrock only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Desktop (public configuration only)
VITE_ARRAB_API_URL=https://arrabapi-production.up.railway.app
