# =============================================================================
# LOCAL / EXAMPLES ONLY — never commit real secrets.
# Production: put provider keys + DATABASE_URL on the Arrab API host.
# Desktop may only know the public API URL.
# =============================================================================

# --- Public Arrab API (production) ---
# Canonical public base used by desktop builds, OAuth redirects, and webhooks.
ARRAB_PUBLIC_BASE_URL=https://api.arrabai.com
# Coolify/Traefik public path (proxy does not strip — API also serves under this prefix).
# When set, prefer ARRAB_PUBLIC_BASE_URL=https://api.arrabai.com/r/nmpi6uidtpkh1bdf for OAuth/webhooks.
ARRAB_API_ROUTE_PREFIX=/r/nmpi6uidtpkh1bdf

# --- Local API (optional: only if you run `pnpm dev:api` on your machine) ---
ARRAB_API_HOST=127.0.0.1
ARRAB_API_PORT=8787
ARRAB_API_LOG_LEVEL=info
ARRAB_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# For local-only runs, override public base:
# ARRAB_PUBLIC_BASE_URL=http://127.0.0.1:8787
# ARRAB_API_ROUTE_PREFIX=
# PostgreSQL — optional for local API. Leave unset for in-memory.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/arrab

# AES-256-GCM key for encrypting messages, companions, knowledge, memories,
# and connector secrets at rest. Prefer 64 hex chars (32 bytes) or base64 of 32 bytes.
# Required whenever DATABASE_URL is set (override only with ARRAB_ALLOW_INSECURE_DATA_KEY=1).
# DATA_ENCRYPTION_KEY=
# ARRAB_ALLOW_INSECURE_DATA_KEY=

# --- Amazon Bedrock (required on Railway) ---
# Long-term API key from AWS Bedrock → API keys → Generate long-term API key
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-north-1
BEDROCK_MODELS=amazon.nova-lite-v1:0,amazon.nova-pro-v1:0,google.gemma-3-12b-it,openai.gpt-oss-120b-1:0
ARRAB_DEFAULT_MODEL=amazon.nova-lite-v1:0

# Desktop (public configuration only)
VITE_ARRAB_API_URL=https://api.arrabai.com
VITE_ARRAB_API_ROUTE_PREFIX=/r/nmpi6uidtpkh1bdf
# Local:
# VITE_ARRAB_API_URL=http://127.0.0.1:8787
# VITE_ARRAB_API_ROUTE_PREFIX=

# OpenRouter (optional — recommended while Bedrock is blocked)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemini-2.5-flash,deepseek/deepseek-chat,anthropic/claude-3.5-haiku,openai/gpt-4o-mini
ARRAB_AI_PROVIDER=openrouter
ARRAB_DEFAULT_MODEL=google/gemini-2.5-flash

# Direct ChatGPT / Claude / Grok (optional — registered alongside OpenRouter/Bedrock)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# --- Gmail OAuth (Google Cloud OAuth client — Web application) ---
# Redirect URI must be: {ARRAB_PUBLIC_BASE_URL}/v1/connectors/gmail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to {ARRAB_PUBLIC_BASE_URL}/v1/connectors/gmail/oauth/callback
# GOOGLE_OAUTH_REDIRECT_URI=

# --- Outlook OAuth (Microsoft Entra / Azure app registration) ---
# Redirect URI must be: {ARRAB_PUBLIC_BASE_URL}/v1/connectors/outlook/oauth/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional override
# MICROSOFT_OAUTH_REDIRECT_URI=

# --- WhatsApp Business Cloud API (Meta) ---
# Webhook callback URL: {ARRAB_PUBLIC_BASE_URL}/v1/connectors/whatsapp/webhook
# Verify token must match Meta App → WhatsApp → Configuration → Callback verify token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret from Meta App Dashboard (validates X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# META_APP_SECRET=  # alias for WHATSAPP_APP_SECRET

# --- GitHub App OAuth (GitHub → Settings → Developer settings → GitHub Apps) ---
# Callback / Redirect URI must be: {ARRAB_PUBLIC_BASE_URL}/v1/connectors/github/oauth/callback
# Enable "Request user authorization (OAuth) during installation" on the App.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional: app slug from https://github.com/apps/{slug} — opens install+login in the browser
# GITHUB_APP_SLUG=arrab-studio
# Optional override; defaults to {ARRAB_PUBLIC_BASE_URL}/v1/connectors/github/oauth/callback
# GITHUB_OAUTH_REDIRECT_URI=

# --- GitLab OAuth ---
# Redirect URI: {ARRAB_PUBLIC_BASE_URL}/v1/connectors/gitlab/oauth/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# GITLAB_OAUTH_REDIRECT_URI=

# --- Bitbucket OAuth ---
# Redirect URI: {ARRAB_PUBLIC_BASE_URL}/v1/connectors/bitbucket/oauth/callback
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
# BITBUCKET_OAUTH_REDIRECT_URI=

# --- Linear OAuth ---
# Redirect URI: {ARRAB_PUBLIC_BASE_URL}/v1/connectors/linear/oauth/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# LINEAR_OAUTH_REDIRECT_URI=

# --- Slack OAuth ---
# Redirect URI: {ARRAB_PUBLIC_BASE_URL}/v1/connectors/slack/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=

# --- Notion OAuth ---
# Redirect URI: {ARRAB_PUBLIC_BASE_URL}/v1/connectors/notion/oauth/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=

# --- WHOOP OAuth ---
# Redirect URI: https://api.arrabai.com/v1/connectors/whoop/oauth/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://api.arrabai.com/v1/connectors/whoop/oauth/callback

# --- Fitbit OAuth ---
# Redirect URI: https://api.arrabai.com/v1/connectors/fitbit/oauth/callback
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=https://api.arrabai.com/v1/connectors/fitbit/oauth/callback

# --- Google Drive OAuth (defaults to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET) ---
# Redirect URI: https://api.arrabai.com/v1/connectors/google_drive/oauth/callback
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://api.arrabai.com/v1/connectors/google_drive/oauth/callback

# --- Google Calendar OAuth (defaults to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET) ---
# Redirect URI: https://api.arrabai.com/v1/connectors/google_calendar/oauth/callback
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.arrabai.com/v1/connectors/google_calendar/oauth/callback

# --- Figma OAuth ---
# Redirect URI: https://api.arrabai.com/v1/connectors/figma/oauth/callback
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=https://api.arrabai.com/v1/connectors/figma/oauth/callback

# --- Finnhub (market data for Trader companions) ---
# Platform key used when a workspace has no per-workspace Finnhub connector.
# Webhook: POST {ARRAB_PUBLIC_BASE_URL}/v1/connectors/finnhub/webhook
# Header: X-Finnhub-Secret must match FINNHUB_WEBHOOK_SECRET
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=

# --- Arrab Control (ERP companion catalog) ---
# Bearer token for /erp/companions. Scopes: companions:read, companions:write
# ARRAB_ERP_TOKEN=
# ARRAB_ERP_TOKEN_SCOPES=companions:read,companions:write
