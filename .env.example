# Arrab API (never commit real values)
ARRAB_API_HOST=127.0.0.1
ARRAB_API_PORT=8787
ARRAB_API_LOG_LEVEL=info
ARRAB_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# PostgreSQL — optional. Leave unset for in-memory persistence.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/arrab

# Model provider keys belong on the API only. Never put these in the desktop app.
# OpenRouter / OpenAI-compatible:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Experiential Labs (required for gpt-5.6-luna):
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
ARRAB_DEFAULT_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# xAI Grok (optional — OpenAI-compatible at https://api.x.ai/v1)
XAI_API_KEY=
# ARRAB_DEFAULT_MODEL=grok-3-mini

# Desktop (public configuration only)
VITE_ARRAB_API_URL=http://127.0.0.1:8787
