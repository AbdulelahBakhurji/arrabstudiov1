{
  "name": "arrab-studio",
  "private": true,
  "type": "module",
  "version": "0.12.0",
  "description": "Arrab Studio — build your AI workforce.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @arrab/api dev",
    "dev:desktop": "bash scripts/dev-desktop.sh",
    "build": "pnpm --filter \"@arrab/*\" -r --sort build",
    "typecheck": "pnpm --filter \"@arrab/*\" -r --sort typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:feature": "node scripts/new-feature.mjs",
    "ship": "bash scripts/package-release.sh",
    "ship:mac": "bash scripts/build-mac.sh",
    "ship:windows": "bash scripts/build-windows.sh",
    "ship:mac:universal": "ARRAB_UNIVERSAL=1 bash scripts/build-mac.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "playwright-core": "1.55.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
